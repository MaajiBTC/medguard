# Copy to .env for local dev (never commit the real .env — it's gitignored).
# On Render, set these as Environment Variables in the service dashboard instead
# of a file.

SECRET_KEY=generate-a-new-random-value-do-not-reuse-this-one

# Local dev only. Leave unset (or False) on Render.
DEBUG=True

# Required by `manage.py create_staff_account` (run automatically in the
# Render build step). Set the real value only in Render's Environment tab or
# your local .env — never commit it.
STAFF_LOGIN_PASSWORD=change-me

# Render's managed Postgres provides this automatically when you link a
# Postgres instance to the web service (Render sets it for you — no need to
# type it in). Leave unset locally to fall back to SQLite.
# DATABASE_URL=postgres://user:password@host:port/dbname

# Security Ledger's separate database (see CLAUDE.md Security Ledger). Leave unset to
# fall back to a second local SQLite file (backend/ledger.sqlite3) — fine for local
# dev, but ephemeral if left unset on Render. Point this at a real separate database
# (ideally a different provider than DATABASE_URL's, e.g. a free Neon/Supabase
# Postgres) once one is provisioned.
# LEDGER_DATABASE_URL=postgres://user:password@host:port/dbname

# See CLAUDE.md Contextual module. IT sets this once per real workstation;
# left unset on a dev machine / cloud deploy.
# WORKSTATION_NETWORK_SEGMENT=ward-3-nurses-station

# Ledger live-feed "explain with AI" feature (ledger/gemini.py) -- get a key
# at https://aistudio.google.com/apikey. Left unset, that feature returns a
# friendly error instead of a real explanation.
# GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-3.6-flash

# Login brute-force lockout (access/services.py). An account locks after this
# many failed attempts and unlocks on its own once they age out of the window;
# an admin can also clear it early from the Staff panel. Defaults shown.
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15

# Step-up verification via device biometrics (Face ID/fingerprint/Windows
# Hello) -- see access/views.py, scoring/views.py. WEBAUTHN_RP_ID and
# WEBAUTHN_ORIGIN must match the FRONTEND's real domain in production (the
# Vercel deploy), NOT this backend's Render domain -- WebAuthn ties a
# credential to the origin the browser is actually on. Defaults below are
# for local dev only, where both point at localhost regardless of port.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=MedGuard
# WEBAUTHN_ORIGIN=http://localhost:5173

# MedGuard Identity (identity/crypto.py) -- encrypts enrolled fingerprint
# templates at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# A dev-only fallback key is baked into settings.py so local dev works
# without this set, but never rely on that past local dev -- losing/rotating
# this key makes every already-enrolled template unreadable.
# FINGERPRINT_TEMPLATE_KEY=generate-a-new-fernet-key-do-not-reuse-this-one
# Minimum similarity score (0-100) counted as a match. Default shown.
# FINGERPRINT_MATCH_THRESHOLD=40

# Patient SMS notifications (notifications/services.py) -- sends the patient
# a text whenever their record is accessed in a way CLAUDE.md's scoring
# bands already treat as noteworthy (anything but a clean, silent access).
# Left unset, notify_patient() just records why it couldn't send instead of
# erroring. Get these from https://console.twilio.com — a free trial account
# works, but can only text numbers you've verified there, and prefixes every
# message with "Sent from your Twilio trial account".
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM_NUMBER=+1your-twilio-number
